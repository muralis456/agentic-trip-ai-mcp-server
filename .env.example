# MCP server runtime
MCP_SERVER_PROTOCOL=STATELESS
MCP_SECURITY_ENABLED=true
MCP_API_KEY=replace-with-a-strong-secret

# Optional shared PostgreSQL state. Enable this when running more than one MCP replica.
MCP_DISTRIBUTED_STATE_ENABLED=true
MCP_DB_URL=jdbc:postgresql://localhost:5432/travel_agent
MCP_DB_USERNAME=travel_app
MCP_DB_PASSWORD=replace-with-a-strong-secret
MCP_DB_POOL_MAX=8
MCP_DB_POOL_MIN=1
MCP_DB_CONNECTION_TIMEOUT_MS=3000

# Distributed fixed-window request limit
MCP_DISTRIBUTED_RATE_LIMIT_ENABLED=true
MCP_DISTRIBUTED_RATE_LIMIT_REQUESTS=120
MCP_DISTRIBUTED_RATE_LIMIT_WINDOW_SECONDS=60
